<!doctype html>
<html lang="it">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Neon Snake</title>
  <script src="/_sdk/element_sdk.js"></script>
  <style>
    body {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      height: 100%;
      overflow: hidden;
      font-family: 'Orbitron', 'Arial', sans-serif;
      background: #0a0a1a;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    html {
      height: 100%;
    }

    #gameContainer {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      position: relative;
    }

    #title {
      font-size: 48px;
      font-weight: bold;
      color: #00ff88;
      text-shadow: 0 0 20px #00ff88, 0 0 40px #00ff88;
      margin-bottom: 20px;
      text-align: center;
    }

    #scoreBoard {
      font-size: 24px;
      color: #ff00ff;
      text-shadow: 0 0 10px #ff00ff;
      margin-bottom: 20px;
    }

    #gameCanvas {
      border: 3px solid #00ffff;
      box-shadow: 0 0 30px #00ffff, inset 0 0 30px rgba(0, 255, 255, 0.1);
      background: #0f0f2a;
      max-width: 600px;
      max-height: 600px;
    }

    #controls {
      margin-top: 30px;
      display: grid;
      grid-template-columns: repeat(3, 80px);
      grid-template-rows: repeat(3, 80px);
      gap: 10px;
    }

    .control-btn {
      background: linear-gradient(145deg, #1a1a3a, #0f0f2a);
      border: 2px solid #00ffff;
      color: #00ffff;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
      transition: all 0.2s;
      touch-action: manipulation;
      user-select: none;
    }

    .control-btn:active {
      transform: scale(0.95);
      box-shadow: 0 0 25px rgba(0, 255, 255, 0.8);
    }

    #upBtn { grid-column: 2; grid-row: 1; }
    #leftBtn { grid-column: 1; grid-row: 2; }
    #downBtn { grid-column: 2; grid-row: 2; }
    #rightBtn { grid-column: 3; grid-row: 2; }

    #gameOverScreen {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(10, 10, 26, 0.95);
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 10;
    }

    #gameOverText {
      font-size: 56px;
      color: #ff0066;
      text-shadow: 0 0 30px #ff0066;
      margin-bottom: 20px;
    }

    #finalScore {
      font-size: 32px;
      color: #00ff88;
      text-shadow: 0 0 15px #00ff88;
      margin-bottom: 40px;
    }

    #playButton {
      padding: 20px 60px;
      font-size: 28px;
      font-weight: bold;
      background: linear-gradient(145deg, #00ff88, #00cc66);
      border: none;
      color: #0a0a1a;
      cursor: pointer;
      box-shadow: 0 0 30px #00ff88;
      transition: all 0.3s;
      font-family: 'Orbitron', 'Arial', sans-serif;
    }

    #playButton:hover {
      transform: scale(1.05);
      box-shadow: 0 0 50px #00ff88;
    }

    #playButton:active {
      transform: scale(0.98);
    }

    @media (max-width: 768px) {
      #title {
        font-size: 32px;
      }

      #scoreBoard {
        font-size: 18px;
      }

      #controls {
        grid-template-columns: repeat(3, 60px);
        grid-template-rows: repeat(3, 60px);
        gap: 8px;
      }

      .control-btn {
        font-size: 20px;
      }

      #gameOverText {
        font-size: 40px;
      }

      #finalScore {
        font-size: 24px;
      }

      #playButton {
        padding: 15px 40px;
        font-size: 20px;
      }
    }
  </style>
  <style>@view-transition { navigation: auto; }</style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
  <script src="https://cdn.tailwindcss.com" type="text/javascript"></script>
 </head>
 <body>
  <div id="gameContainer">
   <div id="title">
    NEON SNAKE
   </div>
   <div id="scoreBoard">
    Punteggio: <span id="score">0</span>
   </div>
   <canvas id="gameCanvas"></canvas>
   <div id="controls"><button class="control-btn" id="upBtn">▲</button> <button class="control-btn" id="leftBtn">◄</button> <button class="control-btn" id="downBtn">▼</button> <button class="control-btn" id="rightBtn">►</button>
   </div>
   <div id="gameOverScreen">
    <div id="gameOverText">
     GAME OVER
    </div>
    <div id="finalScore">
     Punteggio Finale: <span id="finalScoreValue">0</span>
    </div><button id="playButton">GIOCA</button>
   </div>
  </div>
  <script>
    const defaultConfig = {
      game_title: "NEON SNAKE",
      score_label: "Punteggio",
      game_over_text: "GAME OVER",
      play_button_text: "GIOCA",
      background_color: "#0a0a1a",
      primary_color: "#00ff88",
      secondary_color: "#ff00ff",
      accent_color: "#00ffff",
      game_over_color: "#ff0066",
      font_family: "Orbitron",
      font_size: 16
    };

    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    
    const gridSize = 20;
    let tileCount;
    let snake = [];
    let food = {};
    let dx = 0;
    let dy = 0;
    let score = 0;
    let gameLoop;
    let gameRunning = false;

    function resizeCanvas() {
      const container = document.getElementById('gameContainer');
      const maxSize = Math.min(container.clientWidth - 40, container.clientHeight - 300, 600);
      canvas.width = maxSize;
      canvas.height = maxSize;
      tileCount = Math.floor(maxSize / gridSize);
    }

    function initGame() {
      resizeCanvas();
      snake = [
        { x: Math.floor(tileCount / 2), y: Math.floor(tileCount / 2) }
      ];
      dx = 0;
      dy = 0;
      score = 0;
      document.getElementById('score').textContent = score;
      placeFood();
      gameRunning = true;
      document.getElementById('gameOverScreen').style.display = 'none';
      
      if (gameLoop) clearInterval(gameLoop);
      gameLoop = setInterval(update, 100);
    }

    function placeFood() {
      food = {
        x: Math.floor(Math.random() * tileCount),
        y: Math.floor(Math.random() * tileCount)
      };
      
      for (let segment of snake) {
        if (segment.x === food.x && segment.y === food.y) {
          placeFood();
          return;
        }
      }
    }

    function update() {
      if (!gameRunning) return;

      const head = { x: snake[0].x + dx, y: snake[0].y + dy };

      if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
        gameOver();
        return;
      }

      for (let segment of snake) {
        if (segment.x === head.x && segment.y === head.y) {
          gameOver();
          return;
        }
      }

      snake.unshift(head);

      if (head.x === food.x && head.y === food.y) {
        score++;
        document.getElementById('score').textContent = score;
        placeFood();
      } else {
        snake.pop();
      }

      draw();
    }

    function draw() {
      const config = window.elementSdk ? window.elementSdk.config : defaultConfig;
      
      ctx.fillStyle = config.background_color || defaultConfig.background_color;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.shadowBlur = 15;
      ctx.shadowColor = config.secondary_color || defaultConfig.secondary_color;
      ctx.fillStyle = config.secondary_color || defaultConfig.secondary_color;
      ctx.fillRect(food.x * gridSize, food.y * gridSize, gridSize - 2, gridSize - 2);

      ctx.shadowColor = config.primary_color || defaultConfig.primary_color;
      for (let i = 0; i < snake.length; i++) {
        const segment = snake[i];
        const gradient = ctx.createLinearGradient(
          segment.x * gridSize, 
          segment.y * gridSize,
          segment.x * gridSize + gridSize, 
          segment.y * gridSize + gridSize
        );
        
        if (i === 0) {
          gradient.addColorStop(0, config.primary_color || defaultConfig.primary_color);
          gradient.addColorStop(1, config.accent_color || defaultConfig.accent_color);
        } else {
          const alpha = 1 - (i / snake.length) * 0.5;
          gradient.addColorStop(0, config.primary_color || defaultConfig.primary_color);
          gradient.addColorStop(1, config.primary_color || defaultConfig.primary_color);
          ctx.globalAlpha = alpha;
        }
        
        ctx.fillStyle = gradient;
        ctx.fillRect(segment.x * gridSize, segment.y * gridSize, gridSize - 2, gridSize - 2);
        ctx.globalAlpha = 1;
      }
      
      ctx.shadowBlur = 0;
    }

    function gameOver() {
      gameRunning = false;
      clearInterval(gameLoop);
      document.getElementById('finalScoreValue').textContent = score;
      document.getElementById('gameOverScreen').style.display = 'flex';
    }

    function changeDirection(newDx, newDy) {
      if (!gameRunning) return;
      if (dx === -newDx && dy === -newDy) return;
      if (dx === 0 && dy === 0) {
        dx = newDx;
        dy = newDy;
        return;
      }
      dx = newDx;
      dy = newDy;
    }

    document.getElementById('upBtn').addEventListener('click', () => changeDirection(0, -1));
    document.getElementById('downBtn').addEventListener('click', () => changeDirection(0, 1));
    document.getElementById('leftBtn').addEventListener('click', () => changeDirection(-1, 0));
    document.getElementById('rightBtn').addEventListener('click', () => changeDirection(1, 0));

    document.addEventListener('keydown', (e) => {
      switch(e.key.toLowerCase()) {
        case 'w': changeDirection(0, -1); break;
        case 's': changeDirection(0, 1); break;
        case 'a': changeDirection(-1, 0); break;
        case 'd': changeDirection(1, 0); break;
      }
    });

    document.getElementById('playButton').addEventListener('click', initGame);

    window.addEventListener('resize', () => {
      if (gameRunning) {
        resizeCanvas();
        draw();
      }
    });

    async function onConfigChange(config) {
      const titleElement = document.getElementById('title');
      const scoreLabelElement = document.getElementById('scoreBoard');
      const gameOverTextElement = document.getElementById('gameOverText');
      const playButtonElement = document.getElementById('playButton');
      const body = document.body;
      const gameCanvas = document.getElementById('gameCanvas');
      const controlBtns = document.querySelectorAll('.control-btn');

      const customFont = config.font_family || defaultConfig.font_family;
      const baseFontStack = 'Arial, sans-serif';
      const baseSize = config.font_size || defaultConfig.font_size;

      titleElement.textContent = config.game_title || defaultConfig.game_title;
      titleElement.style.fontFamily = `${customFont}, ${baseFontStack}`;
      titleElement.style.fontSize = `${baseSize * 3}px`;
      titleElement.style.color = config.primary_color || defaultConfig.primary_color;
      titleElement.style.textShadow = `0 0 20px ${config.primary_color || defaultConfig.primary_color}, 0 0 40px ${config.primary_color || defaultConfig.primary_color}`;

      const scoreLabel = config.score_label || defaultConfig.score_label;
      scoreLabelElement.innerHTML = `${scoreLabel}: <span id="score">${score}</span>`;
      scoreLabelElement.style.fontFamily = `${customFont}, ${baseFontStack}`;
      scoreLabelElement.style.fontSize = `${baseSize * 1.5}px`;
      scoreLabelElement.style.color = config.secondary_color || defaultConfig.secondary_color;
      scoreLabelElement.style.textShadow = `0 0 10px ${config.secondary_color || defaultConfig.secondary_color}`;

      gameOverTextElement.textContent = config.game_over_text || defaultConfig.game_over_text;
      gameOverTextElement.style.fontFamily = `${customFont}, ${baseFontStack}`;
      gameOverTextElement.style.fontSize = `${baseSize * 3.5}px`;
      gameOverTextElement.style.color = config.game_over_color || defaultConfig.game_over_color;
      gameOverTextElement.style.textShadow = `0 0 30px ${config.game_over_color || defaultConfig.game_over_color}`;

      playButtonElement.textContent = config.play_button_text || defaultConfig.play_button_text;
      playButtonElement.style.fontFamily = `${customFont}, ${baseFontStack}`;
      playButtonElement.style.fontSize = `${baseSize * 1.75}px`;
      playButtonElement.style.background = `linear-gradient(145deg, ${config.primary_color || defaultConfig.primary_color}, ${config.primary_color || defaultConfig.primary_color})`;
      playButtonElement.style.boxShadow = `0 0 30px ${config.primary_color || defaultConfig.primary_color}`;

      body.style.background = config.background_color || defaultConfig.background_color;
      
      gameCanvas.style.borderColor = config.accent_color || defaultConfig.accent_color;
      gameCanvas.style.boxShadow = `0 0 30px ${config.accent_color || defaultConfig.accent_color}, inset 0 0 30px rgba(0, 255, 255, 0.1)`;

      controlBtns.forEach(btn => {
        btn.style.borderColor = config.accent_color || defaultConfig.accent_color;
        btn.style.color = config.accent_color || defaultConfig.accent_color;
        btn.style.boxShadow = `0 0 15px ${config.accent_color || defaultConfig.accent_color}`;
        btn.style.fontFamily = `${customFont}, ${baseFontStack}`;
      });

      const finalScoreElement = document.getElementById('finalScore');
      finalScoreElement.style.fontFamily = `${customFont}, ${baseFontStack}`;
      finalScoreElement.style.fontSize = `${baseSize * 2}px`;
      finalScoreElement.style.color = config.primary_color || defaultConfig.primary_color;
      finalScoreElement.style.textShadow = `0 0 15px ${config.primary_color || defaultConfig.primary_color}`;

      if (gameRunning) {
        draw();
      }
    }

    if (window.elementSdk) {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange,
        mapToCapabilities: (config) => ({
          recolorables: [
            {
              get: () => config.background_color || defaultConfig.background_color,
              set: (value) => {
                config.background_color = value;
                window.elementSdk.setConfig({ background_color: value });
              }
            },
            {
              get: () => config.primary_color || defaultConfig.primary_color,
              set: (value) => {
                config.primary_color = value;
                window.elementSdk.setConfig({ primary_color: value });
              }
            },
            {
              get: () => config.secondary_color || defaultConfig.secondary_color,
              set: (value) => {
                config.secondary_color = value;
                window.elementSdk.setConfig({ secondary_color: value });
              }
            },
            {
              get: () => config.accent_color || defaultConfig.accent_color,
              set: (value) => {
                config.accent_color = value;
                window.elementSdk.setConfig({ accent_color: value });
              }
            },
            {
              get: () => config.game_over_color || defaultConfig.game_over_color,
              set: (value) => {
                config.game_over_color = value;
                window.elementSdk.setConfig({ game_over_color: value });
              }
            }
          ],
          borderables: [],
          fontEditable: {
            get: () => config.font_family || defaultConfig.font_family,
            set: (value) => {
              config.font_family = value;
              window.elementSdk.setConfig({ font_family: value });
            }
          },
          fontSizeable: {
            get: () => config.font_size || defaultConfig.font_size,
            set: (value) => {
              config.font_size = value;
              window.elementSdk.setConfig({ font_size: value });
            }
          }
        }),
        mapToEditPanelValues: (config) => new Map([
          ["game_title", config.game_title || defaultConfig.game_title],
          ["score_label", config.score_label || defaultConfig.score_label],
          ["game_over_text", config.game_over_text || defaultConfig.game_over_text],
          ["play_button_text", config.play_button_text || defaultConfig.play_button_text]
        ])
      });
    }

    resizeCanvas();
    draw();
  </script>
